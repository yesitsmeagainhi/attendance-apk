# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios

# android/ IS committed on purpose. It carries the release signing config, the
# reactNativeArchitectures setting that takes the APK from 118 MB to 66 MB, and
# the Gradle memory tuning this host needs. Regenerating it from app.json alone
# would silently lose all three and produce a debug-signed 118 MB build.
# Only build artifacts and machine-specific paths are excluded.
/android/build/
/android/.gradle/
/android/.kotlin/
/android/app/build/
/android/app/.cxx/
/android/local.properties
/android/app/*.jks
/android/keystore.properties

# Release signing material - never commit
android/keystore.properties
android/app/*.jks

# Release signing material - never commit. Kept outside android/ because
# `expo prebuild --clean` deletes that whole directory.
credentials/

# Built APKs - GitHub rejects files over 100 MB and binaries bloat every clone.
# Ship them as GitHub Release assets instead.
*.apk
*.aab
